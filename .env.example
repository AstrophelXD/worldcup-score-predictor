# Copy to .env and adjust as needed.

# Project root override (optional; defaults to current directory)
# WORLDCUP_ROOT=.

# API URL for Streamlit dashboard
# WORLDCUP_API_URL=http://127.0.0.1:8000

# Active model for inference (baseline_dixon_coles | midlevel | scoregen)
# WORLDCUP_MODEL=baseline_dixon_coles
